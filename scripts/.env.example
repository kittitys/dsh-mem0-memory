# dsh-mem0-memory — mem0-server 配置模板
# 用法：复制为 .env（或运行 `python setup.py --init` 自动生成）后填写两个 API key。
# 优先级：环境变量 > .env > server 内置默认值。

# ── LLM（事实提取，记忆入库时调用）──────────────────────────────
# DeepSeek 或任意 OpenAI 兼容服务
MEM0_LLM_API_KEY=
# MEM0_LLM_MODEL=deepseek-v4-flash
# MEM0_LLM_BASE_URL=https://api.deepseek.com/v1

# ── Embedding（向量化，记忆检索时调用）──────────────────────────
# SiliconFlow 免费档即可（中文推荐 Qwen3-Embedding-8B）；也可用任意 OpenAI 兼容服务
MEM0_EMBEDDING_API_KEY=
# MEM0_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# MEM0_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# MEM0_EMBEDDING_DIMS=4096

# ── 数据与归属（可选）────────────────────────────────────────────
# 向量库数据目录（默认 ./mem0_store；首次建库后不可随意更改 embedding 模型/维度）
# MEM0_DATA_DIR=./mem0_store
# 记忆归属标识（多用户/多实例隔离用，默认 "default"）
# MEM0_USER_ID=default
